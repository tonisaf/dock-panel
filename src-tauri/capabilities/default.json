{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the panel window and the widgets on the desktop",
  "webviews": [
    "main",
    "desk-*",
    "deskgrid"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "autostart:default",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "obsidian://open*"
        }
      ]
    }
  ]
}
